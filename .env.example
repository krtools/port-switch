# Copy to .env (same folder as switch.js) and set a long random password, e.g.
#   openssl rand -base64 24
# Restart the proxy after changing it (portctl restart proxy); that also logs out every browser.
SWITCH_PASSWORD=

# How long the login cookie lasts.
# SWITCH_COOKIE_DAYS=365

# Cookie domain. Leave unset to send the cookie only to the exact host you logged in on
# (strictest). Setting e.g. example.com also sends it to every *.example.com subdomain.
# SWITCH_COOKIE_DOMAIN=
