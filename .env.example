# Copy to .env in the same folder as servers.json and set a long random password, e.g.
#   openssl rand -base64 24
# By default that's the folder with the code; --config <file> or PORT_SWITCH_CONFIG=<file>
# moves servers.json, and this .env (and run/) go with it.
# Restart the proxy after changing it (portctl restart proxy); that also logs out every browser.
SWITCH_PASSWORD=

# How long the login cookie lasts.
# SWITCH_COOKIE_DAYS=365

# Cookie domain. Leave unset to send the cookie only to the exact host you logged in on
# (strictest). Setting e.g. example.com also sends it to every *.example.com subdomain.
# SWITCH_COOKIE_DOMAIN=

# How many previous runs' logs to keep per server (<name>.log.1, .2, ...; 0 = overwrite on
# each start). Overrides "logs": { "keep": N } in servers.json; default 5.
# PORT_SWITCH_LOG_KEEP=5
